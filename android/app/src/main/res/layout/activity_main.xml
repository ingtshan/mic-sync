<?xml version="1.0" encoding="utf-8"?>
<!-- 与桌面/iOS 网页版同款设计:中央大录音按钮,使用中按钮后方滚动真实音波 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_dim"
            android:textSize="12sp" />

        <!-- 波形舞台:音波横贯全宽,大按钮压在中央 -->
        <FrameLayout
            android:id="@+id/mic_stage"
            android:layout_width="match_parent"
            android:layout_height="280dp">

            <com.micsync.android.WaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_gravity="center" />

            <View
                android:id="@+id/pulse1"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/ring_pulse"
                android:visibility="gone" />

            <View
                android:id="@+id/pulse2"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/ring_pulse"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btn_mic"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_armed"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/btn_mic_desc">

                <ImageView
                    android:id="@+id/mic_icon"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_paused"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/sub_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:paddingHorizontal="14dp"
            android:text="@string/sub_paused"
            android:textColor="@color/text_dim"
            android:textSize="12.5sp" />

        <!-- 连接地址卡片:服务运行时展示 -->
        <LinearLayout
            android:id="@+id/conn_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_address"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/ip_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/no_network"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:textStyle="bold"
                android:typeface="monospace" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/hint"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
